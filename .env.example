# Demo mode: simulated DecisionLogic + local application accept (no real third-party calls)
# Set both to false when DecisionLogic IP + Profile parent URL are whitelisted.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# DecisionLogic (server-only — never expose to the browser)
# Swagger: https://integration.decisionlogic.com/restful/swagger/index.html
# Docs package: ../DecisionLogic/
DECISIONLOGIC_BASE_URL=https://integration.decisionlogic.com/restful/v1
DECISIONLOGIC_SERVICE_KEY=
DECISIONLOGIC_SITE_USER_GUID=
DECISIONLOGIC_PROFILE_GUID=
# -1 = IAV only; 4 = DL Match (used automatically when owner identity fields are present)
DECISIONLOGIC_DEFAULT_MATCH_TYPE=-1

# LoanPro LOS (server-only — sandbox pending from client)
LOANPRO_BASE_URL=
LOANPRO_API_KEY=
LOANPRO_TENANT_ID=
